{
  "name": "@que2333/dsh-codex-preset",
  "version": "0.1.0",
  "description": "Adds a Codex-style Agent preset to DeepSeek Harness",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./runtime": "./runtime.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "prompt.js",
    "prompts/*.md",
    "prompts/*.json",
    "LICENSES/*.txt",
    "transform.js",
    "tool-descriptions.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que2333/dsh-codex-preset.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "prompt"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "summary": {
        "en": "Adds a Codex-style Agent preset with an autonomous workflow, system prompt, and tool descriptions.",
        "zh": "\u65b0\u589e\u4e00\u4e2a Codex \u98ce\u683c\u7684 Agent \u9884\u8bbe\uff0c\u5305\u542b\u81ea\u4e3b\u5de5\u4f5c\u6d41\u3001\u7cfb\u7edf\u63d0\u793a\u8bcd\u548c\u5de5\u5177\u63cf\u8ff0\u3002"
      },
      "category": "agent"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
